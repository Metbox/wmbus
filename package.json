{
  "name": "@metbox/wmbus",
  "version": "0.0.1",
  "description": "TypeScript implementation of the wireless M-Bus (wM-Bus) protocol and meter drivers. Derived from wmbusmeters (GPL-3.0).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drivers": {
      "types": "./dist/drivers/index.d.ts",
      "import": "./dist/drivers/index.js"
    },
    "./registry": {
      "types": "./dist/drivers/registry.d.ts",
      "import": "./dist/drivers/registry.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/drivers/builtin/*"
  ],
  "scripts": {
    "harvest": "tsx scripts/harvest-fixtures.ts",
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint ./src ./test ./scripts",
    "format": "biome format --write ./src ./test ./scripts",
    "check": "biome check --write ./src ./test ./scripts",
    "prepare": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@types/node": "^22.19.7",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "wmbus",
    "wireless-mbus",
    "mbus",
    "metering",
    "iot",
    "aes-128",
    "wmbusmeters"
  ],
  "author": "Metbox",
  "homepage": "https://github.com/Metbox/wmbus#readme",
  "bugs": {
    "url": "https://github.com/Metbox/wmbus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Metbox/wmbus.git"
  }
}
